{
  "name": "glass-dock",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:web": "pnpm --filter @glass-dock/web dev",
    "dev:desktop": "pnpm --filter @glass-dock/desktop tauri dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @glass-dock/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
